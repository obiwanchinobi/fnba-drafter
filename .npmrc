# Supply-chain install policy. See docs/architecture/supply-chain.md.
# Delay versions published in the last 7 days (npm >= 11.10).
min-release-age=7
# Block dependency lifecycle scripts (preinstall / install / postinstall).
ignore-scripts=true
# Do not fetch git-hosted dependencies.
allow-git=none
# Pin exact versions in package.json when adding packages.
save-exact=true
# Always write a lockfile.
package-lock=true
# Audit on install.
audit=true
# Fail when engines.npm / engines.node are unsatisfied (once those fields exist).
engine-strict=true
