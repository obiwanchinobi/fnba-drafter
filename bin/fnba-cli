#!/bin/bash

# FNBA repo CLI. Committed entry point for worktree helpers; alias this as fnba-cli.
#
# Usage:
#   fnba-cli                                Interactive menu (create / refresh / remove / dev-proxy)
#   fnba-cli wt [branch] [--no-db]          Create a worktree (fast path requires main)
#   fnba-cli wt-refresh-db [-y] [--no-migrate]
#   fnba-cli wt-remove [branch] [-y] [--force]
#   fnba-cli dev-proxy                      Start the dev proxy (once per machine)
#   fnba-cli shell-init                     Print `alias fnba-cli=...` for ~/.zshrc
#   fnba-cli help
#
# Direct script names also work: bin/git-wt, bin/git-wt-refresh-db, bin/git-wt-remove, bin/dev-proxy.
# Subcommand aliases: git-wt, git-wt-refresh-db, refresh-db, git-wt-remove, remove.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/fnba-wt-common.sh
. "${BIN_DIR}/lib/fnba-wt-common.sh"

usage() {
    cat <<EOF
fnba-cli — FNBA worktree CLI (this repository only)

Commands:
  (no args)                           Interactive menu
  wt [branch] [--no-db]               Create a worktree under ../fnba-drafter-worktrees/
  wt-refresh-db [-y] [--no-migrate]   Bootstrap or refresh this worktree's isolated DBs
  wt-remove [branch] [-y] [--force]   Remove a worktree, drop its DBs, and delete its local branch
  dev-proxy                           Start the FNBA Caddy dev proxy (once per machine)
  shell-init                          Print the alias line to add to ~/.zshrc
  help                                Show this help

Examples:
  fnba-cli
  fnba-cli wt ft/board
  fnba-cli wt ft/board --no-db
  fnba-cli wt-refresh-db
  fnba-cli wt-remove ft/board -y
  fnba-cli dev-proxy
  eval "\$(/path/to/fnba-drafter/bin/fnba-cli shell-init)"

Worktrees are for parallel development: one git-mutating session per worktree.
See docs/architecture/worktrees.md.
EOF
}

interactive_root() {
    echo -e "${MAGENTA}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${MAGENTA}        fnba-cli — FNBA worktree CLI${NC}"
    echo -e "${MAGENTA}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "  ${CYAN}1)${NC} Create a worktree"
    echo -e "  ${CYAN}2)${NC} Refresh this worktree's DB"
    echo -e "  ${CYAN}3)${NC} Remove a worktree"
    echo -e "  ${CYAN}4)${NC} Start the dev proxy"
    echo -e "  ${CYAN}h)${NC} Help"
    echo ""
    while true; do
        echo -en "${BLUE}Enter number, h for help, or q to quit: ${NC}"
        choice=""
        read -r choice || true
        case "$choice" in
            1)
                echo ""
                exec "${BIN_DIR}/git-wt"
                ;;
            2)
                echo ""
                exec "${BIN_DIR}/git-wt-refresh-db"
                ;;
            3)
                echo ""
                exec "${BIN_DIR}/git-wt-remove"
                ;;
            4)
                echo ""
                exec "${BIN_DIR}/dev-proxy"
                ;;
            [Hh]|help)
                echo ""
                usage
                exit 0
                ;;
            ""|[Qq]|quit)
                echo -e "${YELLOW}Exiting...${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection: ${choice}${NC}"
                echo ""
                ;;
        esac
    done
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$cmd" in
    "")
        interactive_root
        ;;
    wt|git-wt)
        exec "${BIN_DIR}/git-wt" "$@"
        ;;
    wt-refresh-db|git-wt-refresh-db|refresh-db)
        exec "${BIN_DIR}/git-wt-refresh-db" "$@"
        ;;
    wt-remove|git-wt-remove|remove)
        exec "${BIN_DIR}/git-wt-remove" "$@"
        ;;
    dev-proxy)
        exec "${BIN_DIR}/dev-proxy" "$@"
        ;;
    shell-init)
        printf "alias fnba-cli=%q\n" "${BIN_DIR}/fnba-cli"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: ${cmd}" >&2
        echo "" >&2
        usage >&2
        exit 2
        ;;
esac
