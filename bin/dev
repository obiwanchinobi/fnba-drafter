#!/usr/bin/env bash
# Start the Rails API and Vite SPA together. Ctrl-C (or any exit) kills the process group.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# A missing backend/.env.local is the primary checkout. The && list must not
# trip set -e. Blank PORT / FRONTEND_PORT still fall back below.
set -a
[ -f "${ROOT}/backend/.env.local" ] && . "${ROOT}/backend/.env.local"
set +a

# shellcheck source=lib/fnba-wt-ports.sh
. "${ROOT}/bin/lib/fnba-wt-ports.sh"

rails_port="${PORT:-3000}"
vite_port="${FRONTEND_PORT:-5173}"

cleanup() {
  trap - EXIT INT TERM
  # Negative PID = this script's process group (Rails + Vite + their children).
  kill -- -$$ 2>/dev/null || true
}

trap cleanup EXIT INT TERM

echo "API  http://127.0.0.1:${rails_port}"
echo "SPA  http://localhost:${vite_port}  (open this URL)"
# No slug means the primary checkout: the API and SPA lines above are enough.
if [ -n "${FNBA_HOST_SLUG:-}" ]; then
  echo "Browse ${FRONTEND_ORIGIN}"
  if ! fnba_dev_proxy_running; then
    echo "The dev proxy is not running — that URL is dead until you run bin/dev-proxy (once per machine, its own terminal). Direct: http://localhost:${vite_port}"
  fi
fi

(
  cd "${ROOT}/backend"
  exec ./bin/rails server -b 127.0.0.1 -p "${rails_port}"
) &

(
  cd "${ROOT}/frontend"
  exec npm run dev
) &

wait
